<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.poc.mule</groupId>
    <artifactId>mule-aws-secrets-poc</artifactId>
    <version>1.0.0</version>
    <packaging>mule-application</packaging>

    <name>mule-aws-secrets-poc</name>
    <description>
        PoC application validating AWS Secrets Manager database credential retrieval and credential
        rotation behaviour through the aws-secretsmanager-jdbc wrapper driver, targeting PostgreSQL on
        AWS RDS and later executed inside AWS EKS with EKS Pod Identity.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <app.runtime>4.12.3</app.runtime>
        <mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <mule.http.connector.version>1.12.1</mule.http.connector.version>
        <mule.db.connector.version>1.16.4</mule.db.connector.version>

        <aws.secretsmanager.jdbc.version>2.1.3</aws.secretsmanager.jdbc.version>
        <postgresql.version>42.7.13</postgresql.version>

        <!-- Sibling jdbc-cache-ttl/ project; see its README notes and the build instructions. -->
        <jdbc.cache.ttl.version>1.0.0</jdbc.cache.ttl.version>
        <!--
            Aligned with the AWS SDK v2 version declared by aws-secretsmanager-jdbc:2.1.3
            (secretsmanager 2.41.3 / aws-crt-client 2.41.3). Keeping STS on the same version
            minimises dependency-version variables for this PoC: the driver's own transitive
            graph and our explicit STS dependency then agree natively, with no upgrade forced
            across the connector classloader.
        -->
        <aws.java.sdk.version>2.41.3</aws.java.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Single source of truth for every AWS SDK v2 module, including the transitive
                modules pulled in by aws-secretsmanager-jdbc. This keeps STS, Secrets Manager
                and the shared SDK core/http modules on one consistent version.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.java.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${mule.http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-db-connector</artifactId>
            <version>${mule.db.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!--
            JDBC / AWS libraries. These are declared as provided so they are not exported by the
            application classloader; the Database Connector receives them through the
            additionalPluginDependencies block below, which is the documented Mule 4 driver
            visibility model.
        -->
        <dependency>
            <groupId>com.amazonaws.secretsmanager</groupId>
            <artifactId>aws-secretsmanager-jdbc</artifactId>
            <version>${aws.secretsmanager.jdbc.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            The two AWS SDK v2 modules below are already transitive dependencies of
            aws-secretsmanager-jdbc:2.1.3 at the same version we target. They are declared
            explicitly (version managed by the BOM above) so the alignment is visible and so a
            future STS bump cannot silently reintroduce a mixed AWS SDK v2 version set across
            the connector classloader.

            aws-crt-client is NOT optional: JDBCSecretCacheBuilderProvider hard-wires the
            Secrets Manager client to
            SecretsManagerClientBuilder.httpClientBuilder(AwsCrtHttpClient.builder()
                .postQuantumTlsEnabled(...))
            so removing it would fail at connection time with NoClassDefFoundError. Because the
            HTTP client is supplied explicitly by the driver, the SDK never runs ServiceLoader
            discovery for it, so the apache client module coexisting on the classpath is harmless.

            software.amazon.awssdk.crt:aws-crt (the native binding) is intentionally NOT pinned;
            we take whatever version aws-crt-client selects transitively.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-crt-client</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Required later on EKS: the default credential provider chain resolves EKS Pod Identity via STS. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                    <additionalPluginDependencies>
                        <!--
                            Database Connector classloader isolation: the connector cannot see the
                            application's dependencies, so the JDBC driver and the AWS libraries it
                            needs are injected directly into the mule-db-connector plugin classloader.
                        -->
                        <plugin>
                            <groupId>org.mule.connectors</groupId>
                            <artifactId>mule-db-connector</artifactId>
                            <additionalDependencies>
                                <!--
                                    NOTE: additionalPluginDependencies are resolved by the
                                    mule-maven-plugin and do NOT inherit this project's
                                    dependencyManagement / imported AWS SDK BOM, and <exclusions>
                                    declared here are ignored by the plugin. Every AWS SDK module we
                                    care about is therefore re-declared with an explicit version so
                                    nearest-wins resolution pins the whole connector classloader to
                                    one AWS SDK v2 version.

                                    sts must stay in this list: it is what lets the AWS Default
                                    Credential Provider Chain resolve EKS Pod Identity credentials
                                    from inside the Database Connector classloader.
                                -->
                                <!--
                                    Makes the AWS secret cache TTL configurable via
                                    AWS_SECRET_CACHE_TTL_SECONDS. It must live HERE, in the
                                    connector classloader, because the Database Connector resolves
                                    driverClassName with Class.forName inside its own classloader
                                    and cannot see Mule application classes.

                                    Built from the sibling jdbc-cache-ttl/ project, which must be
                                    installed first:  cd jdbc-cache-ttl && mvn clean install
                                -->
                                <dependency>
                                    <groupId>com.poc.mule</groupId>
                                    <artifactId>mule-aws-secrets-poc-jdbc-cache-ttl</artifactId>
                                    <version>${jdbc.cache.ttl.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>com.amazonaws.secretsmanager</groupId>
                                    <artifactId>aws-secretsmanager-jdbc</artifactId>
                                    <version>${aws.secretsmanager.jdbc.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>secretsmanager</artifactId>
                                    <version>${aws.java.sdk.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>aws-crt-client</artifactId>
                                    <version>${aws.java.sdk.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>org.postgresql</groupId>
                                    <artifactId>postgresql</artifactId>
                                    <version>${postgresql.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>sts</artifactId>
                                    <version>${aws.java.sdk.version}</version>
                                </dependency>
                            </additionalDependencies>
                        </plugin>
                    </additionalPluginDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
        </pluginRepository>
    </pluginRepositories>

</project>
