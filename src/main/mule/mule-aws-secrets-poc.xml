<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:java="http://www.mulesoft.org/schema/mule/java"
      xmlns:spring="http://www.mulesoft.org/schema/mule/spring"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/java http://www.mulesoft.org/schema/mule/java/current/mule-java.xsd
        http://www.mulesoft.org/schema/mule/spring http://www.mulesoft.org/schema/mule/spring/current/mule-spring.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- All environment specific values come from application.properties, which in turn
         reads environment variables provided by the runtime / Kubernetes Deployment. -->
    <configuration-properties file="application.properties" doc:name="Application properties"/>

    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!-- Loads the HikariCP DataSource bean; see src/main/resources/spring-beans.xml. -->
    <spring:config name="springConfig" files="spring-beans.xml" doc:name="Spring Config"/>

    <!--
        Database Connector -> Spring/HikariDataSource -> TtlConfiguredPostgreSQLDriver
          -> AWSSecretsManagerPostgreSQLDriver -> AWS Secrets Manager -> PostgreSQL -> RDS.

        * The connector no longer builds the connection itself; it uses the Hikari pool through
          dataSourceRef. The JDBC URL, the secret id used as "username", the driver class and all
          pool tuning now live in spring-beans.xml, driven by environment variables.
        * HikariCP is the ONLY connection pool. There is deliberately NO <db:pooling-profile> here,
          so the connector adds no second layer of pooling on top of Hikari.
        * No database password exists anywhere in this configuration: the AWS wrapper driver
          resolves username and password from Secrets Manager on each physical connection, using
          the AWS Default Credential Provider Chain (EKS Pod Identity).
    -->
    <db:config name="Database_Config" doc:name="Database Config">
        <db:data-source-connection dataSourceRef="hikariDataSource"/>
    </db:config>

    <!-- ===================================================================
         GET /health - liveness of the Mule application only. No DB access.

         The pool block is diagnostic ONLY. HikariPoolStatusProvider just reads
         counters and configuration; it never asks the pool for a connection, so
         this endpoint stays independent of database connectivity and the status
         stays UP even when the pool holds no connections or is still starting.
         =================================================================== -->
    <flow name="health-flow" doc:name="health-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/health" allowedMethods="GET" doc:name="GET /health">
            <http:response statusCode="200">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:response>
        </http:listener>

        <java:invoke doc:name="Read Hikari pool status"
                     class="com.poc.mule.awssecrets.health.HikariPoolStatusProvider"
                     method="status()"
                     instance="#[app.registry.hikariPoolStatusProvider]"
                     target="poolStatus"/>

        <ee:transform doc:name="Build health response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "UP",
    application: "mule-aws-secrets-poc",
    pool: vars.poolStatus
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- ===================================================================
         GET /db-test - proves real connectivity and returns safe evidence of
         the physical PostgreSQL session.

         pg_backend_pid() identifies the PostgreSQL backend process serving the
         connection. Comparing it across calls (and across a credential
         rotation) tells us whether Mule reused an existing physical JDBC
         session or authenticated a brand new one.
         =================================================================== -->
    <flow name="db-test-flow" doc:name="db-test-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/db-test" allowedMethods="GET" doc:name="GET /db-test">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 503]">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:error-response>
        </http:listener>

        <db:select config-ref="Database_Config" doc:name="Select session evidence">
            <db:sql><![CDATA[SELECT
    current_user AS db_user,
    pg_backend_pid() AS backend_pid,
    current_timestamp AS db_timestamp]]></db:sql>
        </db:select>

        <!-- Snapshot taken after the select, so the connection used by the query has already been
             returned to the pool: expect it to appear as idle rather than active. -->
        <java:invoke doc:name="Read Hikari pool status"
                     class="com.poc.mule.awssecrets.health.HikariPoolStatusProvider"
                     method="status()"
                     instance="#[app.registry.hikariPoolStatusProvider]"
                     target="poolStatus"/>

        <ee:transform doc:name="Build db-test response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var row = payload[0]
---
{
    status: "UP",
    database: {
        user: row.db_user,
        backendPid: row.backend_pid,
        timestamp: row.db_timestamp as String
    },
    pool: vars.poolStatus
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <error-handler>
            <!-- Safe diagnostics only: error type plus the connector description.
                 Never log the secret contents, the resolved username/password or the
                 JDBC credential properties. -->
            <on-error-continue type="ANY" logException="false" doc:name="DB failure -> 503">
                <logger level="ERROR" category="com.poc.mule.awssecrets.dbtest"
                        message='#["/db-test failed. errorType=" ++ (error.errorType.namespace default "UNKNOWN") ++ ":" ++ (error.errorType.identifier default "UNKNOWN") ++ " | description=" ++ (error.description default "no description")]'
                        doc:name="Log DB failure"/>

                <set-variable variableName="httpStatus" value="#[503]" doc:name="Set 503"/>

                <java:invoke doc:name="Read Hikari pool status"
                             class="com.poc.mule.awssecrets.health.HikariPoolStatusProvider"
                             method="status()"
                             instance="#[app.registry.hikariPoolStatusProvider]"
                             target="poolStatus"/>

                <ee:transform doc:name="Build error response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "DOWN",
    component: "database",
    errorType: (error.errorType.namespace default "UNKNOWN") ++ ":" ++ (error.errorType.identifier default "UNKNOWN"),
    pool: vars.poolStatus
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
