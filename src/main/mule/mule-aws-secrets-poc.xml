<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- All environment specific values come from application.properties, which in turn
         reads environment variables provided by the runtime / Kubernetes Deployment. -->
    <configuration-properties file="application.properties" doc:name="Application properties"/>

    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!--
        Database Connector -> Generic Connection -> AWS Secrets Manager JDBC wrapper driver.

        * driverClassName is a thin shim around the AWS wrapper driver, not org.postgresql.Driver.
          The shim exists only to make the AWS secret cache TTL configurable through the
          AWS_SECRET_CACHE_TTL_SECONDS environment variable, which aws-secretsmanager-jdbc 2.1.3
          exposes no property for. It delegates every JDBC call to a
          com.amazonaws.secretsmanager.sql.AWSSecretsManagerPostgreSQLDriver instance built with a
          SecretCacheConfiguration, so connection behaviour is otherwise unchanged. It ships in the
          sibling jdbc-cache-ttl artifact and is injected into the Database Connector classloader
          via additionalPluginDependencies.
        * The JDBC sub-protocol "jdbc-secretsmanager:postgresql" tells the wrapper to resolve
          credentials from AWS Secrets Manager and delegate to the PostgreSQL driver.
        * "user" carries the Secrets Manager secret id, which is configuration and not a credential.
        * There is deliberately NO password attribute: the wrapper driver resolves both username and
          password from the secret using the AWS Default Credential Provider Chain.
        * There is deliberately NO <db:pooling-profile>. Phase 1 must observe raw physical JDBC
          session creation and AWS secret caching behaviour without a pool in the way.
    -->
    <db:config name="Database_Config" doc:name="Database Config">
        <db:generic-connection
                url="jdbc-secretsmanager:postgresql://${db.host}:${db.port}/${db.name}"
                driverClassName="com.poc.mule.awssecrets.jdbc.TtlConfiguredPostgreSQLDriver"
                user="${aws.secret.id}"/>
    </db:config>

    <!-- ===================================================================
         GET /health - liveness of the Mule application only. No DB access.
         =================================================================== -->
    <flow name="health-flow" doc:name="health-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/health" allowedMethods="GET" doc:name="GET /health">
            <http:response statusCode="200">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:response>
        </http:listener>

        <ee:transform doc:name="Build health response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "UP",
    application: "mule-aws-secrets-poc"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- ===================================================================
         GET /db-test - proves real connectivity and returns safe evidence of
         the physical PostgreSQL session.

         pg_backend_pid() identifies the PostgreSQL backend process serving the
         connection. Comparing it across calls (and across a credential
         rotation) tells us whether Mule reused an existing physical JDBC
         session or authenticated a brand new one.
         =================================================================== -->
    <flow name="db-test-flow" doc:name="db-test-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/db-test" allowedMethods="GET" doc:name="GET /db-test">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 503]">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:error-response>
        </http:listener>

        <db:select config-ref="Database_Config" doc:name="Select session evidence">
            <db:sql><![CDATA[SELECT
    current_user AS db_user,
    pg_backend_pid() AS backend_pid,
    current_timestamp AS db_timestamp]]></db:sql>
        </db:select>

        <ee:transform doc:name="Build db-test response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var row = payload[0]
---
{
    status: "UP",
    database: {
        user: row.db_user,
        backendPid: row.backend_pid,
        timestamp: row.db_timestamp as String
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <error-handler>
            <!-- Safe diagnostics only: error type plus the connector description.
                 Never log the secret contents, the resolved username/password or the
                 JDBC credential properties. -->
            <on-error-continue type="ANY" logException="false" doc:name="DB failure -> 503">
                <logger level="ERROR" category="com.poc.mule.awssecrets.dbtest"
                        message='#["/db-test failed. errorType=" ++ (error.errorType.namespace default "UNKNOWN") ++ ":" ++ (error.errorType.identifier default "UNKNOWN") ++ " | description=" ++ (error.description default "no description")]'
                        doc:name="Log DB failure"/>

                <set-variable variableName="httpStatus" value="#[503]" doc:name="Set 503"/>

                <ee:transform doc:name="Build error response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "DOWN",
    component: "database",
    errorType: (error.errorType.namespace default "UNKNOWN") ++ ":" ++ (error.errorType.identifier default "UNKNOWN")
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
