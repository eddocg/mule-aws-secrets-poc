<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.poc.mule</groupId>
    <artifactId>mule-aws-secrets-poc-jdbc-cache-ttl</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>mule-aws-secrets-poc-jdbc-cache-ttl</name>
    <description>
        Tiny JDBC driver shim that makes the aws-secretsmanager-jdbc secret cache TTL externally
        configurable via the AWS_SECRET_CACHE_TTL_SECONDS environment variable.

        This is a SEPARATE artifact, and deliberately not part of the Mule application, because the
        Mule Database Connector loads its driver class inside the connector's own classloader, which
        cannot see Mule application classes. It is injected into the mule-db-connector classloader
        through the parent project's mule-maven-plugin additionalPluginDependencies configuration.

        Build/install this module BEFORE building the Mule application, by running
        "mvn clean install" from inside the jdbc-cache-ttl directory.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Kept in sync with the parent PoC project. -->
        <aws.secretsmanager.jdbc.version>2.1.3</aws.secretsmanager.jdbc.version>
        <aws.java.sdk.version>2.41.3</aws.java.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.java.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Everything is 'provided' on purpose. These libraries are already present in the
        mule-db-connector classloader (the Mule application declares them in
        additionalPluginDependencies), so this artifact must contribute ONLY its own single class
        and must not drag a second copy of the AWS SDK into the connector classloader.
    -->
    <dependencies>
        <dependency>
            <groupId>com.amazonaws.secretsmanager</groupId>
            <artifactId>aws-secretsmanager-jdbc</artifactId>
            <version>${aws.secretsmanager.jdbc.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
